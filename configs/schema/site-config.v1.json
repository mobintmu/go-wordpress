{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-wordpress.local/schema/site-config.v1.json",
  "title": "Site config v1",
  "description": "One site's product page parsing rules. A site file may extend a template from configs/templates/; objects are merged deeply and the site's arrays replace the template's. The service checks the merged result with the same rules (internal/siteconfig/loader.go), plus selector and regular expression compilation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "version", "domains"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "schema_version": { "const": 1 },
    "site_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "version": { "type": "string", "minLength": 1, "description": "Returned as config_version, for example 2026-11-08.1" },
    "enabled": { "type": "boolean", "default": true },
    "extends": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Template name in configs/templates/ without .json" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9-]{2,63}$" }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_agent": { "type": "string", "default": "ProductExtractor/1.0" },
        "delay_ms": { "type": "integer", "minimum": 0, "maximum": 60000, "default": 1000 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 2 },
        "respect_robots_txt": { "type": "boolean", "default": true }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price_unit": { "enum": ["toman", "rial"], "default": "toman" },
        "currency_words": { "type": "array", "items": { "type": "string" } },
        "call_for_price_words": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "match": { "type": "array", "minItems": 1, "items": { "type": "string", "description": "Go regular expression on the URL path" } },
            "root": { "type": "string", "minLength": 1, "description": "CSS selector of the element that contains the product" },
            "price_area": { "type": "string", "description": "CSS selector whose text is returned as price.raw and checked for call_for_price_words" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": { "$ref": "#/$defs/field" },
                "image_url": { "$ref": "#/$defs/field" },
                "price_current": { "$ref": "#/$defs/field" },
                "price_regular": { "$ref": "#/$defs/field" },
                "description": { "$ref": "#/$defs/field" }
              }
            },
            "availability": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "out_of_stock": { "type": "string" },
                "order_button": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "enum": ["title", "image_url", "price_current", "price_regular", "description"] }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "attr": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string", "minLength": 1 } }
          ],
          "description": "Attributes tried in order; without attr the element text is used"
        },
        "pick": { "enum": ["first", "last", "join"], "default": "first" },
        "separator": { "type": "string", "description": "Used with pick join" }
      }
    }
  }
}
